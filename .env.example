# Local Docker profile
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5436
INGESTION_API_PORT=5104
JWT_KEY=<secure-shared-identity-key-at-least-32-bytes>
JWT_ISSUER=smartpalm.identity
JWT_AUDIENCE=smartpalm.clients
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=smartpalm_ingestion;Username=smartpalm_ingestion;Password=replace-with-a-local-postgres-password
RABBITMQ_URI=amqp://guest:guest@rabbitmq:5672/
RABBITMQ_EXCHANGE=smartpalm.events
RABBITMQ_QUEUE=smartpalm.ingestion
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Vultr/Coolify deployment: configure these as secrets in Coolify.
# ConnectionStrings__IngestionDatabase=Host=10.6.96.4;Port=5432;Database=smartpalm_ingestion;Username=smartpalm_ingestion;Password=<password>
# ASPNETCORE_ENVIRONMENT=Production
# ASPNETCORE_URLS=http://+:8080
# Jwt__Issuer=smartpalm.identity
# Jwt__Audience=smartpalm.clients
# Jwt__Key=<secure-shared-identity-key-at-least-32-bytes>
# RabbitMq__Enabled=true
# RabbitMq__Uri=amqp://<username>:<password>@10.6.96.4:5672/
# RabbitMq__Exchange=smartpalm.events
# RabbitMq__Queue=smartpalm.ingestion
